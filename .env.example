VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# macOS sign-in: Google Cloud -> APIs & Services -> Credentials ->
# OAuth client ID -> Desktop app. `build.rs` reads these from `.env.local`
# (or the process env) and passes them to the Rust build only, so neither value
# is ever inlined into the JS bundle. Keep them out of git.
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=

# Legacy fallback still accepted by build.rs for the client ID. Do not add a
# VITE_-prefixed secret: VITE_* values are bundled into the client.
VITE_GOOGLE_DESKTOP_CLIENT_ID=

# Android needs no env vars. Drop the Firebase `google-services.json` in
# `android/app/` (git-ignored) before building.
