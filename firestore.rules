rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Owner-only, collection-allowlisted, shape-checked writes. Normal record
    // deletion still uses tombstones (deleted: true); deletes are allowed so
    // Settings can permanently erase the whole account (`deleteAllData`).
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isRecordCollection(name) {
      return name == 'blocks' || name == 'tasks' || name == 'notes' || name == 'deadlines'
        || name == 'habits';
    }

    // Records are plain JSON written with the record id as the document id.
    // `id` and `updatedAt` are required: the pull cursor filters on updatedAt
    // and merge relies on the id surviving the round trip. `updatedAt` is an
    // ISO-8601 string throughout the app (not a numeric timestamp).
    // `expireAt` is the tombstone TTL timestamp; the app writes it only on
    // soft-deleted records.
    //
    // The rules language has no byte-size property on a resource (only
    // `resource.data`), so the document size is bounded by the field count
    // here and by the byte cap the app applies before it writes
    // (`STATE_APP_MAX_BYTES`, `RECORD_MAX_BYTES`).
    function recordShape(docId) {
      let d = request.resource.data;
      return d.keys().size() <= 40
        && ('id' in d && d.id is string && d.id == docId)
        && ('updatedAt' in d && d.updatedAt is string && d.updatedAt.size() > 0)
        && (!('deleted' in d) || d.deleted is bool)
        && (!('deviceId' in d) || d.deviceId is string)
        && (!('createdAt' in d) || d.createdAt is string)
        && (!('expireAt' in d) || d.expireAt is timestamp);
    }

    function habitShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'schedule', 'checkins'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 90
        && d.schedule in ['daily', 'weekdays']
        && d.checkins is list && d.checkins.size() <= 4000
        && (!('reminder' in d) || d.reminder == null || (d.reminder is string && d.reminder.matches('^[0-2][0-9]:[0-5][0-9]$')));
    }

    // `state/app` holds the singletons, `state/stats` the day map (split out so
    // its growth can never block the singletons), and `state/preferences` must
    // never carry a plaintext AI key (it lives in the platform secure store).
    //
    // The day map is capped by its day count: the app trims the oldest days
    // until the document fits in `STATE_APP_MAX_BYTES`.
    function stateShape(docId) {
      let d = request.resource.data;
      return (
        (docId == 'app' && d.keys().hasOnly(['profile', 'layout', 'settings', 'dayStats']))
        || (docId == 'stats' && d.keys().size() <= 4000)
        || (
          docId == 'preferences'
          && d.keys().size() <= 40
          && (!('ai' in d) || !('apiKey' in d.ai))
        )
      );
    }

    match /users/{uid} {
      // The user root document is unused; only subcollections are accessible.
      allow read, write: if false;

      match /state/{docId} {
        allow read: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && stateShape(docId);
        allow delete: if signedInAs(uid);
      }

      match /{collection}/{docId} {
        allow read: if signedInAs(uid) && isRecordCollection(collection);
        allow create, update: if signedInAs(uid)
          && isRecordCollection(collection)
          && recordShape(docId)
          && (collection != 'habits' || habitShape());
        allow delete: if signedInAs(uid) && isRecordCollection(collection);
      }
    }
  }
}
